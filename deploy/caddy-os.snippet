# Append to /home/hiten/infra/caddy/Caddyfile, then reload Caddy.
# Curly OS — gated by Authentik forward-auth (embedded outpost), exactly like
# the journal. block. Only difference: upstream is :3100.
os.curlybrackets.art {
	# Let the embedded outpost endpoints pass straight through to Authentik
	reverse_proxy /outpost.goauthentik.io/* 127.0.0.1:9000

	route {
		forward_auth 127.0.0.1:9000 {
			uri /outpost.goauthentik.io/auth/caddy
			copy_headers X-authentik-username X-authentik-groups X-authentik-email X-authentik-name X-authentik-uid X-authentik-jwt X-authentik-meta-jwks X-authentik-meta-outpost X-authentik-meta-provider X-authentik-meta-app X-authentik-meta-version
			trusted_proxies private_ranges
		}
		# Curly's realtime voice socket -> the curly-voice backend, same origin.
		reverse_proxy /ws 127.0.0.1:3200
		# Everything else -> the curly-os Next app (SSE chat streams unbuffered).
		reverse_proxy 127.0.0.1:3100
	}
}
